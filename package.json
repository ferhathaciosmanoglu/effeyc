{
  "name": "effeyc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:github": "DEPLOY_TARGET=github vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "pages:dev": "npx --yes wrangler@4 pages dev dist --port 8788",
    "deploy": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name=effeyc --branch=main"
  },
  "dependencies": {
    "@paper-design/shaders": "^0.0.82",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
